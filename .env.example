# Supabase (required)
# Copy to .env.local and fill in values from the project Connect dialog.
# Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only secret key from Settings → API Keys (sb_secret_... or legacy service_role JWT).
# Used for admin user deletion. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# ---------------------------------------------------------------------------
# Local Supabase OAuth (supabase start / supabase db reset only)
# OAuth provider secrets are configured in Supabase, not in Next.js env.
# For local CLI, set these in .env.local or your shell before `supabase start`.
# Remote/production: configure providers in Supabase Dashboard → Authentication.
# ---------------------------------------------------------------------------

# Google OAuth app (redirect URI: http://127.0.0.1:54321/auth/v1/callback)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
