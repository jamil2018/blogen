# Supabase (required)
# Copy to .env.local and fill in values from the project Connect dialog.
# Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only secret key from Settings → API Keys (sb_secret_... or legacy service_role JWT).
# Used for admin user deletion. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# ---------------------------------------------------------------------------
# Resend (Stage C newsletters / welcome / webhooks)
# Requires an owned sending domain + region metadata:
#   npx vercel --non-interactive integration add resend/resend-email --no-claim --plan free \
#     -m domain=YOUR_DOMAIN -m region=us-east-1
# then `npx vercel env pull .env.local --yes`. Do not fake sends without these.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Cron secret for /api/cron/publish-scheduled (manual — not from Marketplace)
CRON_SECRET=

# ---------------------------------------------------------------------------
# Stripe (Stage D memberships / Connect / webhooks)
# Provisioned via: `npx vercel --non-interactive integration add stripe --no-claim`
# then `npx vercel env pull .env.local --yes`.
# Marketplace also sets STRIPE_PUBLISHABLE_KEY (alias) and STRIPE_MCP_KEY (unused).
# STRIPE_WEBHOOK_SECRET is NOT auto-provisioned — create webhook then paste secret.
# See docs/qa/checkpoint-f.md / docs/qa/ops-progress.md.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Alias sometimes set by Marketplace (app also accepts this if NEXT_PUBLIC_ is missing)
STRIPE_PUBLISHABLE_KEY=
# Optional — Connect Express (manual / claim)
STRIPE_CONNECT_CLIENT_ID=
# Marketplace MCP helper key (unused by Blogen app)
STRIPE_MCP_KEY=

# Public site URL used for Checkout / Portal / Connect return URLs (manual)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Local Supabase OAuth (supabase start / supabase db reset only)
# OAuth provider secrets are configured in Supabase, not in Next.js env.
# For local CLI, set these in .env.local or your shell before `supabase start`.
# Remote/production: configure providers in Supabase Dashboard → Authentication.
# ---------------------------------------------------------------------------

# Google OAuth app (redirect URI: http://127.0.0.1:54321/auth/v1/callback)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=